<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.cqrs4j</groupId>
        <artifactId>cqrs-4-java-springboot</artifactId>
        <version>0.7.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cqrs-4-java-springboot-bom</artifactId>
    <packaging>pom</packaging>
    <description>${description} (BOM)</description>

    <!--
        Only what this repository builds. The rest - core, esc, jackson, jsonb, jpa, test-helper - is
        managed by cqrs-4-java-bom, which a consumer imports alongside this one. Keeping the two apart
        means neither can name a version of something released on the other's cadence.
    -->

    <dependencyManagement>

        <dependencies>

            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-springboot-common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-springboot-command-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-springboot-command-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-springboot-query-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-springboot-query-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-springboot-keycloak-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-springboot-keycloak-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-springboot-security</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.cqrs4j</groupId>
                <artifactId>cqrs-4-java-springboot-pm-core</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>

    </dependencyManagement>

</project>
